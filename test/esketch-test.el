;;; esketch-test.el --- ERT suite for esketch  -*- lexical-binding: t; -*-

;;; Commentary:

;; Run with:
;;   emacs -Q --batch -L . -l test/esketch-test.el -f ert-run-tests-batch-and-exit
;;
;; test/json-cases.json is generated by tools/gen-cases.ts from JavaScript's
;; own JSON.stringify, the call Excalidraw saves with.  It is read here with
;; json.el, not with the parser under test.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'json)
(require 'esketch-json)
(require 'esketch-model)

(defconst esketch-test--dir
  (file-name-directory (or load-file-name buffer-file-name)))

(defun esketch-test--file (name)
  (expand-file-name name esketch-test--dir))

(defun esketch-test--slurp (file)
  (with-temp-buffer
    (let ((coding-system-for-read 'utf-8-unix))
      (insert-file-contents file))
    (buffer-string)))

(defun esketch-test--basic ()
  (esketch-json-read-from-string
   (esketch-test--slurp (esketch-test--file "data/basic.excalidraw"))))

;;;; JSON reader and writer

(ert-deftest esketch-test-json-cases ()
  "Every row of the JSON.stringify table is reproduced exactly."
  (let* ((json-array-type 'list)
         (rows (json-read-file (esketch-test--file "json-cases.json")))
         (fails nil))
    (should (> (length rows) 40))
    (dolist (row rows)
      (let ((got (esketch-json-write-to-string
                  (esketch-json-read-from-string (car row)))))
        (unless (equal got (cadr row))
          (push (list (car row) :want (cadr row) :got got) fails))))
    (should (equal fails nil))))

(ert-deftest esketch-test-json-distinct-empties ()
  "null, false, true, {} and [] stay distinct through a read."
  (should (eq (esketch-json-read-from-string "null") :null))
  (should (eq (esketch-json-read-from-string "false") :false))
  (should (eq (esketch-json-read-from-string "true") t))
  (should (equal (esketch-json-read-from-string "{}") '(:obj)))
  (should (equal (esketch-json-read-from-string "[]") [])))

(ert-deftest esketch-test-json-key-order ()
  "Keys keep file order, and a new key goes last, as in JavaScript."
  (let ((o (esketch-json-read-from-string "{\"b\":1,\"a\":2}")))
    (esketch-put o "a" 3)
    (esketch-put o "c" 4)
    (should (equal (esketch-json-write-to-string o)
                   "{\n  \"b\": 1,\n  \"a\": 3,\n  \"c\": 4\n}"))))

(ert-deftest esketch-test-json-rejects-garbage ()
  (should-error (esketch-json-read-from-string "{\"a\":}"))
  (should-error (esketch-json-read-from-string "[1,2"))
  (should-error (esketch-json-read-from-string "1 2")))

;;;; Files

(ert-deftest esketch-test-file-round-trip-basic ()
  "An unmodified fixture is written back byte for byte."
  (let* ((src (esketch-test--file "data/basic.excalidraw"))
         (out (make-temp-file "esketch" nil ".excalidraw")))
    (unwind-protect
        (progn
          (esketch-write-file (esketch-read-file src) out)
          (should (equal (esketch-test--slurp out) (esketch-test--slurp src))))
      (delete-file out))))

(ert-deftest esketch-test-file-keeps-final-newline ()
  "A final newline in the source survives a save; none is added otherwise."
  (let ((in (make-temp-file "esketch" nil ".excalidraw"))
        (out (make-temp-file "esketch" nil ".excalidraw")))
    (unwind-protect
        (progn
          (with-temp-file in (insert "{\n  \"a\": 1\n}\n"))
          (esketch-write-file (esketch-read-file in) out)
          (should (equal (esketch-test--slurp out) "{\n  \"a\": 1\n}\n")))
      (delete-file in)
      (delete-file out))))

(ert-deftest esketch-test-file-unicode ()
  "Non-ASCII text is read as characters and written raw, as UTF-8."
  (let ((in (make-temp-file "esketch" nil ".excalidraw"))
        (out (make-temp-file "esketch" nil ".excalidraw")))
    (unwind-protect
        (let ((coding-system-for-write 'utf-8-unix))
          (with-temp-file in (insert "{\n  \"text\": \"caf\u00e9 \u2192 \U0001F600\"\n}"))
          (let ((f (esketch-read-file in)))
            (should (equal (esketch-get (esketch-file-doc f) "text")
                           "caf\u00e9 \u2192 \U0001F600"))
            (esketch-write-file f out))
          (should (equal (esketch-test--slurp out) (esketch-test--slurp in))))
      (delete-file in)
      (delete-file out))))

;;;; Model

(ert-deftest esketch-test-fractional-index ()
  "Index keys after the last one follow the fractional-indexing library."
  (dolist (c '((nil "a0") ("a0" "a1") ("a1" "a2") ("a9" "aA") ("az" "b00")
               ("Zz" "a0") ("bzz" "c000") ("a0V" "a1")
               ("zzzzzzzzzzzzzzzzzzzzzzzzzzy" "zzzzzzzzzzzzzzzzzzzzzzzzzzz")
               ("zzzzzzzzzzzzzzzzzzzzzzzzzzz" "zzzzzzzzzzzzzzzzzzzzzzzzzzzV")))
    (should (equal (esketch-index-after (car c)) (cadr c)))))

(ert-deftest esketch-test-basic-is-consistent ()
  (should (equal (esketch-binding-errors (esketch-test--basic)) nil)))

(ert-deftest esketch-test-binding-checker-catches ()
  "The checker reports each kind of broken link it promises to."
  (let ((doc (esketch-test--basic)))
    ;; arrow points at the ellipse, ellipse forgets it
    (esketch-put (esketch-element doc "ell1") "boundElements" [])
    (should (= (length (esketch-binding-errors doc)) 1)))
  (let ((doc (esketch-test--basic)))
    ;; text claims a container that does not list it
    (esketch-put (esketch-element doc "text1") "containerId" "dia1")
    (should (>= (length (esketch-binding-errors doc)) 1)))
  (let ((doc (esketch-test--basic)))
    ;; shapes still list an arrow that is gone: stale, not an error
    (esketch-put (esketch-element doc "arrow1") "isDeleted" t)
    (should (equal (esketch-binding-errors doc) nil))
    (should (= (length (esketch-binding-stale doc)) 2))))

(defun esketch-test--abs-points (el)
  (let ((x (esketch-get el "x")) (y (esketch-get el "y")))
    (mapcar (lambda (p) (list (+ x (aref p 0)) (+ y (aref p 1))))
            (esketch-get el "points"))))

(ert-deftest esketch-test-move-drags-bound-arrow-end ()
  "Moving a shape moves its bound text and the arrow end bound to it only."
  (let* ((doc (esketch-test--basic))
         (before (esketch-test--abs-points (esketch-element doc "arrow1")))
         (tx (esketch-get (esketch-element doc "text1") "x")))
    (esketch-move doc "rect1" 10 -20)
    (let ((after (esketch-test--abs-points (esketch-element doc "arrow1"))))
      (should (equal (car after) (list (+ 10 (car (car before)))
                                       (+ -20 (cadr (car before))))))
      (should (equal (car (last after)) (car (last before)))))
    (should (= (esketch-get (esketch-element doc "text1") "x") (+ tx 10)))
    (let ((pts (esketch-get (esketch-element doc "arrow1") "points")))
      (should (equal (aref pts 0) [0 0])))
    (should (equal (esketch-binding-errors doc) nil))))

(ert-deftest esketch-test-move-bumps-version-only-of-touched ()
  (let* ((doc (esketch-test--basic))
         (v (lambda (id) (esketch-get (esketch-element doc id) "version"))))
    (let ((r (funcall v "rect1")) (a (funcall v "arrow1"))
          (d (funcall v "dia1")))
      (esketch-move doc "rect1" 1 1)
      (should (> (funcall v "rect1") r))
      (should (> (funcall v "arrow1") a))
      (should (= (funcall v "dia1") d)))))

(ert-deftest esketch-test-delete-shape-unbinds ()
  (let ((doc (esketch-test--basic)))
    (esketch-delete doc "ell1")
    (should (eq (esketch-get (esketch-element doc "ell1") "isDeleted") t))
    (should (eq (esketch-get (esketch-element doc "arrow1") "endBinding") :null))
    (should (equal (esketch-binding-errors doc) nil)))
  (let ((doc (esketch-test--basic)))
    (esketch-delete doc "rect1")
    (should (eq (esketch-get (esketch-element doc "text1") "isDeleted") t))
    (should (eq (esketch-get (esketch-element doc "arrow1") "startBinding") :null))
    (should (equal (esketch-binding-errors doc) nil))))

(ert-deftest esketch-test-delete-arrow-leaves-shapes-clean ()
  (let ((doc (esketch-test--basic)))
    (esketch-delete doc "arrow1")
    (should (equal (esketch-binding-errors doc) nil))
    (should (equal (append (esketch-get (esketch-element doc "ell1")
                                        "boundElements")
                           nil)
                   nil))))

(ert-deftest esketch-test-add-element ()
  (let* ((doc (esketch-test--basic))
         (id (esketch-add doc (esketch-new-element "rectangle" 0 0 10 10))))
    (let ((el (esketch-element doc id)))
      (should (equal (esketch-get el "type") "rectangle"))
      (should (equal (esketch-get el "index") "a8"))
      (should (= (length id) 21)))))

(defun esketch-test--random-op (doc)
  "Apply one random edit to DOC."
  (let* ((live (cl-remove-if-not #'esketch-live-p
                                 (append (esketch-elements doc) nil)))
         (pick (lambda (pred)
                 (let ((l (cl-remove-if-not pred live)))
                   (and l (nth (random (length l)) l)))))
         (id (lambda (el) (esketch-get el "id")))
         (shape-p (lambda (el) (member (esketch-get el "type")
                                       '("rectangle" "ellipse" "diamond"))))
         (arrow-p (lambda (el) (equal (esketch-get el "type") "arrow"))))
    (pcase (random 7)
      (0 (let ((el (funcall pick #'identity)))
           (when el (esketch-move doc (funcall id el)
                                  (- (random 41) 20) (- (random 41) 20)))))
      (1 (let ((el (funcall pick #'identity)))
           (when (and el (> (length live) 3))
             (esketch-delete doc (funcall id el)))))
      (2 (let ((a (funcall pick arrow-p)) (s (funcall pick shape-p)))
           (when (and a s)
             (esketch-bind doc (funcall id a) (if (zerop (random 2)) 'start 'end)
                           (funcall id s)))))
      (3 (let ((a (funcall pick arrow-p)))
           (when a
             (esketch-unbind doc (funcall id a)
                             (if (zerop (random 2)) 'start 'end)))))
      (4 (esketch-add doc (esketch-new-element
                           (nth (random 3) '("rectangle" "ellipse" "diamond"))
                           (random 500) (random 500) 50 40)))
      (5 (esketch-add doc (esketch-new-element "arrow" (random 500) (random 500)
                                               80 30)))
      (6 (let ((a (funcall pick arrow-p)) (s (funcall pick shape-p)))
           ;; bind both ends to the same shape, a self-loop
           (when (and a s)
             (esketch-bind doc (funcall id a) 'start (funcall id s))
             (esketch-bind doc (funcall id a) 'end (funcall id s))))))))

(ert-deftest esketch-test-binding-invariant-property ()
  "1000 random edit sequences leave no broken or stale link."
  (random "esketch")
  (let ((bad nil))
    (dotimes (seq 1000)
      (let ((doc (esketch-test--basic)))
        (dotimes (_ 12)
          (esketch-test--random-op doc)
          (let ((errs (append (esketch-binding-errors doc)
                              (esketch-binding-stale doc))))
            (when (and errs (not bad))
              (setq bad (list :sequence seq :errors errs)))))))
    (should (equal bad nil))))

(ert-deftest esketch-test-unknown-fields-survive-edits ()
  "Fields esketch does not know are kept through an edit and a save."
  (let ((doc (esketch-test--basic)))
    (esketch-put (esketch-element doc "rect1") "futureField" [1 "x"])
    (esketch-put doc "futureTop" '(:obj ("k" . :null)))
    (esketch-move doc "rect1" 5 5)
    (let ((back (esketch-json-read-from-string
                 (esketch-json-write-to-string doc))))
      (should (equal (esketch-get (esketch-element back "rect1") "futureField")
                     [1 "x"]))
      (should (equal (esketch-get back "futureTop") '(:obj ("k" . :null)))))))

(ert-deftest esketch-test-delete-clears-stale-listing ()
  "Deleting an element drops it from every list that names it, stale or not."
  (let ((doc (esketch-test--basic)))
    (esketch-put (esketch-element doc "dia1") "boundElements"
                 (vector (list :obj (cons "id" "arrow2") (cons "type" "arrow"))))
    (should (= (length (esketch-binding-stale doc)) 1))
    (esketch-delete doc "arrow2")
    (should (equal (esketch-binding-stale doc) nil))))

(ert-deftest esketch-test-legacy-bound-element-ids ()
  "Pre-2021 files list arrows in boundElementIds; edits read and migrate it."
  (let ((doc (esketch-test--basic)))
    (dolist (id '("rect1" "ell1"))
      (let ((el (esketch-element doc id)))
        (esketch-put el "boundElementIds" ["arrow1"])
        (esketch-del el "boundElements")))
    (esketch-put (esketch-element doc "text1") "containerId" :null)
    (should (equal (esketch-binding-errors doc) nil))
    (let ((end (car (last (esketch-test--abs-points
                           (esketch-element doc "arrow1"))))))
      (esketch-move doc "ell1" 7 0)
      (should (equal (car (last (esketch-test--abs-points
                                 (esketch-element doc "arrow1"))))
                     (list (+ 7 (car end)) (cadr end)))))
    (esketch-unbind doc "arrow1" 'end)
    (let ((ell (esketch-element doc "ell1")))
      (should-not (esketch-has ell "boundElementIds"))
      (should (equal (esketch-get ell "boundElements") [])))
    (should (esketch-has (esketch-element doc "rect1") "boundElementIds"))
    (should (equal (append (esketch-binding-errors doc)
                           (esketch-binding-stale doc))
                   nil))))

(provide 'esketch-test)
;;; esketch-test.el ends here
